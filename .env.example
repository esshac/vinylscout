# Optional. Copy this file to .env.local and paste your Discogs personal access token.
# Get one at https://www.discogs.com/settings/developers ("Generate new token").
# Without a token the app still works, but Discogs search returns no cover images
# and the rate limit is 25 requests/minute instead of 60.
# On Replit, add DISCOGS_TOKEN under Secrets instead of using a file.
DISCOGS_TOKEN=
